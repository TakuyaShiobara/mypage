rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'tak.sobr@gmail.com';
    }

    function isValidImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    match /works/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
